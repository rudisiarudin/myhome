# ==============================================================================
# MYHOME PWA - SUPABASE CLIENT CONFIGURATION
# ==============================================================================
# Isi nilai di bawah ini dari Supabase Dashboard -> Project Settings -> API
# Catatan Keamanan: Jangan commit file ini dengan secret/service_role_key ke git publik.
# Gunakan nilai Supabase URL dan Anon Key project Anda.

VITE_SUPABASE_URL=https://[REDACTED].supabase.co
VITE_SUPABASE_ANON_KEY=[REDACTED]
# Bisa memakai publishable key baru sebagai pengganti anon key di atas.
# Jika diisi, variabel ini diprioritaskan.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional App Configurations
VITE_APP_NAME=MyHome
VITE_APP_ENV=development
